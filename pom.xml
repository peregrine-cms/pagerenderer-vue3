<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Use Peregrine parent to get content-package support -->
    <parent>
        <groupId>com.peregrine-cms</groupId>
        <artifactId>parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../peregrine-cms/pom.xml</relativePath>
    </parent>

    <properties>
        <!--
            The peregrine-cms parent declares frontend-maven-plugin in
            <build><plugins> with <nodeVersion>${node.version}</nodeVersion>, so
            the PROPERTY decides which node is installed — an execution-level
            nodeVersion in ui.apps loses to it. Override it here, once, for both
            modules.

            v24 is the current LTS (Krypton); the parent is on v20.20.2. node is
            build-time only — the runtime image ships Java 25 and has no node —
            so this changes the toolchain and nothing that is deployed.
        -->
        <node.version>v24.19.0</node.version>
        <npm.version>11.17.0</npm.version>
    </properties>

    <artifactId>pagerender-vue3.parent</artifactId>
    <packaging>pom</packaging>

    <description>Vue 3 Page Renderer for Peregrine CMS</description>

    <modules>
        <module>core</module>
        <module>ui.apps</module>
    </modules>
</project>
